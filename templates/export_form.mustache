{{!
  @template mod_moodleoverflow/export_form

  The format selection of the export page.

  Example context (json):
  {
      "action": "https://example.org/mod/moodleoverflow/export.php",
      "cmid": 5,
      "formats": [{"value": "csv", "label": "Comma separated values (.csv)"}, {"value": "excel", "label": "Microsoft Excel (.xlsx)"}]
  }
}}
<form method="get" action="{{action}}" class="d-flex flex-wrap align-items-center">
    <input type="hidden" name="id" value="{{cmid}}">
    <label for="mod_moodleoverflow-export-format" class="m-1">{{#str}} exportforumformat, mod_moodleoverflow {{/str}}</label>
    <select name="dataformat" id="mod_moodleoverflow-export-format" class="form-control form-select w-auto m-1">
        {{#formats}}
            <option value="{{value}}">{{label}}</option>
        {{/formats}}
    </select>
    <button type="submit" class="btn btn-secondary m-1">{{#str}} download {{/str}}</button>
</form>
