{{!
  @template mod_moodleoverflow/author

  The author of a post: the name, linked to the profile if the viewer may know who wrote the post, and the reputation
  if the viewer may see it. rating.js updates the reputation after a vote through the data attribute.

  Example context (json):
  {
      "name": "Jane Doe",
      "profileurl": "https://example.com/user/view.php?id=2&course=3",
      "reputation": {"userid": 2, "userreputation": 12}
  }
}}
{{#profileurl}}<a href="{{profileurl}}">{{name}}</a>{{/profileurl}}{{^profileurl}}{{name}}{{/profileurl}}{{#reputation}}
<span class="text-nowrap moodleoverflow-icon-no-margin">{{#pix}}star, moodleoverflow, {{#str}}reputation, moodleoverflow{{/str}}{{/pix}}<span data-moodleoverflow-userreputation="{{userid}}">{{userreputation}}</span></span>{{/reputation}}
