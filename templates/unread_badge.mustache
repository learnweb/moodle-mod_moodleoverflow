{{!
  @template mod_moodleoverflow/unread_badge

  The number of unread posts as a badge that leads to the first unread post. It is a link without underline; it darkens
  on hover and the tooltip says where it leads. readtracking.js removes the badges of a discussion or moodleoverflow
  (data-domain, data-instanceid) when the user marks it as read.

  Example context (json):
  {
      "unreadlink": "https://example.com/mod/moodleoverflow/discussion.php?d=1#unread",
      "unreadamount": 3,
      "domain": "discussion",
      "instanceid": 1
  }
}}
<a href="{{{unreadlink}}}" class="badge rounded-pill bg-primary text-white text-decoration-none moodleoverflow-badge-link unread-part"
   data-region="mod_moodleoverflow/unread-badge" data-domain="{{domain}}" data-instanceid="{{instanceid}}"
   title="{{#str}}unreadbadgelink, mod_moodleoverflow{{/str}}">{{!
}}{{#str}}unreadbadge, mod_moodleoverflow, {{unreadamount}}{{/str}}</a>
