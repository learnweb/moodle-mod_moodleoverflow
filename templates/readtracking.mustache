{{!
    @template mod_moodleoverflow/readtracking

    "Mark as read" for a moodleoverflow in the course overview, with the number of unread posts as a badge
    (readtracking.js).

    Example context (json):
    {
        "itemid": "moodleoverflow-markpostsread-1",
        "domain": "moodleoverflow",
        "instanceid": 1,
        "unreadamount": 3
    }
}}
<span class="unread-part">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="{{itemid}}" data-domain="{{domain}}"
            data-instanceid="{{instanceid}}" title="{{#str}}markallreaddesc, mod_moodleoverflow{{/str}}">{{!
    }}{{#pix}}t/markasread, core{{/pix}}{{#str}}markread, mod_moodleoverflow{{/str}}{{!
    }}<span class="badge rounded-pill bg-primary text-white ms-2" title="{{#str}}unreadposts, mod_moodleoverflow{{/str}}">{{unreadamount}}</span></button>
</span>
{{#js}}
    require(['mod_moodleoverflow/readtracking'], function(readtracking) {
        readtracking.init({{#quote}}{{itemid}}{{/quote}});
    });
{{/js}}
