{{!
    @template mod_moodleoverflow/subscription_toggle

    A button that subscribes to or unsubscribes from a moodleoverflow or a discussion. Loads the JS module
    mod_moodleoverflow/subscription itself. Both states are rendered, the JS shows the current one.

    Context variables required for this template:
    * type - "moodleoverflow" or "discussion"
    * id - The id of the moodleoverflow or discussion
    * subscribed - Whether the user is subscribed now
    * icononly - Show the bell icon instead of a text button (discussion card)

    Example context (json):
    {
        "type": "discussion",
        "id": 2,
        "subscribed": true,
        "icononly": true
    }
}}
<button type="button"
        class="{{#icononly}}btn btn-link p-0 text-muted{{/icononly}}{{^icononly}}btn btn-secondary m-2{{/icononly}}"
        data-action="mod_moodleoverflow/toggle-subscription"
        data-type="{{type}}"
        data-id="{{id}}"
        data-subscribed="{{#subscribed}}1{{/subscribed}}{{^subscribed}}0{{/subscribed}}">
    <span data-state="subscribed" class="{{^subscribed}}d-none{{/subscribed}}">
        {{#icononly}}
            {{#pix}} i/subscribed, mod_moodleoverflow, {{#str}} clicktounsubscribe, mod_moodleoverflow {{/str}} {{/pix}}
        {{/icononly}}
        {{^icononly}}{{#str}} unsubscribe, mod_moodleoverflow {{/str}}{{/icononly}}
    </span>
    <span data-state="unsubscribed" class="{{#subscribed}}d-none{{/subscribed}}">
        {{#icononly}}
            {{#pix}} i/unsubscribed, mod_moodleoverflow, {{#str}} clicktosubscribe, mod_moodleoverflow {{/str}} {{/pix}}
        {{/icononly}}
        {{^icononly}}{{#str}} subscribe, mod_moodleoverflow {{/str}}{{/icononly}}
    </span>
</button>
{{#js}}
    require(['mod_moodleoverflow/subscription'], function(subscription) {
        subscription.init();
    });
{{/js}}
