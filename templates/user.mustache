{{!
  @template mod_moodleoverflow/user

  Moodleoverflow page of the user.php. Show all posts of a user
   Example context (json):
   {
   }
}}
{{#pageavailable}}
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        {{#pix}} i/warning, core {{/pix}}
        <span class="ms-2">{{#str}}featurenotavailable, mod_moodleoverflow{{/str}}</span>
    </div>
{{/pageavailable}}
{{^pageavailable}}
    {{#react}}
        {
        "component": "@moodle/lms/mod_moodleoverflow/User",
        }
        <div class="position-relative">
            <div class="position-absolute top-50 start-50 translate-middle">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">{{#str}}loading, core{{/str}}</span>
                </div>
            </div>
        </div>
    {{/react}}
{{/pageavailable}}

