{{!
  @template mod_moodleoverflow/tracking_toggle

  Switches the read tracking of a moodleoverflow (readtracking.js, which loads the page again). An item of the menu
  "Forum actions", or a button with "asbutton" (single discussion moodleoverflow).

  Example context (json):
  {
      "itemid": "moodleoverflow-tracking-1",
      "instanceid": 1,
      "tracked": true,
      "asbutton": false
  }
}}
<button type="button" id="{{itemid}}" class="{{#asbutton}}btn btn-outline-secondary btn-sm m-1{{/asbutton}}{{^asbutton}}dropdown-item{{/asbutton}}"
        data-instanceid="{{instanceid}}" data-tracked="{{#tracked}}1{{/tracked}}{{^tracked}}0{{/tracked}}"
        title="{{#tracked}}{{#str}} notrackmoodleoverflowdesc, mod_moodleoverflow {{/str}}{{/tracked}}{{!
        }}{{^tracked}}{{#str}} trackmoodleoverflowdesc, mod_moodleoverflow {{/str}}{{/tracked}}">{{!
}}{{#tracked}}{{#pix}}i/show, core{{/pix}}{{#str}} notrackmoodleoverflow, moodleoverflow {{/str}}{{/tracked}}{{!
}}{{^tracked}}{{#pix}}i/hide, core{{/pix}}{{#str}} trackmoodleoverflow, moodleoverflow {{/str}}{{/tracked}}</button>
{{#js}}
    require(['mod_moodleoverflow/readtracking'], function(readtracking) {
        readtracking.initTracking({{#quote}}{{itemid}}{{/quote}});
    });
{{/js}}
