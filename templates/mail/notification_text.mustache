{{!
  @template mod_moodleoverflow/mail/notification_text

  The plain text mail to a subscriber about a new post. Every value is printed unescaped with triple braces, as this
  is text, not HTML. Data from output\mail\notification.

  Context variables required for this template:
  * intro - "There is a new post in <moodleoverflow> -> <discussion>"
  * url - Link to the post
  * by - "by <author> - <date>"
  * message - The post as plain text
  * reply, unsubscribeforum, unsubscribediscussion - Lines with a link, or null if not available

  Example context (json):
  {
    "intro": "There is a new post in Lecture Q&A -> Why does my recursive function never stop?",
    "isquestion": false,
    "url": "https://example.com/mod/moodleoverflow/discussion.php?d=2#p5",
    "authorname": "Jacob Brown",
    "authorpicture": "",
    "by": "by Jacob Brown - Monday, 2 November 2026, 10:15 AM",
    "message": "Your function has no base case.",
    "reply": "This is a copy of a message posted in learnweb. To reply click on this link: https://example.com/mod/moodleoverflow/post.php?reply=5",
    "unsubscribeforum": null,
    "unsubscribediscussion": "Unsubscribe from this discussion: https://example.com/mod/moodleoverflow/discussion.php?d=2&unsubscribe=1"
  }
}}
{{{intro}}}

{{{url}}}

{{{by}}}
---------------------------------------------------------------------
{{{message}}}
---------------------------------------------------------------------
{{#reply}}
{{{reply}}}
{{/reply}}
{{#unsubscribediscussion}}
{{{unsubscribediscussion}}}
{{/unsubscribediscussion}}
{{#unsubscribeforum}}
{{{unsubscribeforum}}}
{{/unsubscribeforum}}
