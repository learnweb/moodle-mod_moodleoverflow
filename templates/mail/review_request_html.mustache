{{!
  @template mod_moodleoverflow/mail/review_request_html

  The HTML mail to a reviewer about a post that waits for its review. Data from output\mail\review_request.

  Context variables required for this template:
  * heading, subheading - See mail/layout_html
  * post - The post with its headline, see mail/post_content_html
  * actions - The button to the post, see mail/actions_html

  Example context (json):
  {
    "heading": "Review needed in the course Programming 101",
    "subheading": "Forum: Lecture Q&A",
    "post": {
      "headline": "Jacob Brown answered in \"Why does my recursive function never stop?\"",
      "author": null,
      "date": "Monday, 2 November 2026, 10:15 AM",
      "messagehtml": "<p>Your function has no base case.</p>"
    },
    "actions": [
      {"url": "https://example.com/mod/moodleoverflow/discussion.php?d=2#p5", "label": "Review post", "primary": true}
    ]
  }
}}
{{< mod_moodleoverflow/mail/layout_html}}
    {{$preheader}}{{#post}}{{headline}}{{/post}}{{/preheader}}
    {{$content}}
        {{#post}}{{> mod_moodleoverflow/mail/post_content_html}}{{/post}}
        {{> mod_moodleoverflow/mail/actions_html}}
    {{/content}}
{{/ mod_moodleoverflow/mail/layout_html}}
