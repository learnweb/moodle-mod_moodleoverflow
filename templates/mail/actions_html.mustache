{{!
  @template mod_moodleoverflow/mail/actions_html

  A row of buttons in an HTML mail. The background sits on the table cell, so the button keeps its colour in mail
  clients that ignore padding on links.

  Context variables required for this template:
  * actions - List of buttons, each with url, label and primary (filled button; otherwise an outlined one)

  Example context (json):
  {
    "actions": [
      {"url": "https://example.com/mod/moodleoverflow/discussion.php?d=2#p5", "label": "View post", "primary": true},
      {"url": "https://example.com/mod/moodleoverflow/post.php?reply=5", "label": "Comment", "primary": false}
    ]
  }
}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:28px;">
<tr>
{{#actions}}
    {{#primary}}
    <td style="background-color:#0f6cbf;border:1px solid #0f6cbf;border-radius:8px;">
        <a href="{{url}}" style="display:inline-block;padding:10px 20px;font-size:14px;font-weight:600;line-height:1.2;
           color:#ffffff;text-decoration:none;">{{label}}</a>
    </td>
    {{/primary}}
    {{^primary}}
    <td style="background-color:#ffffff;border:1px solid #ced4da;border-radius:8px;">
        <a href="{{url}}" style="display:inline-block;padding:10px 20px;font-size:14px;font-weight:600;line-height:1.2;
           color:#1d2125;text-decoration:none;">{{label}}</a>
    </td>
    {{/primary}}
    <td style="width:12px;"></td>
{{/actions}}
</tr>
</table>
