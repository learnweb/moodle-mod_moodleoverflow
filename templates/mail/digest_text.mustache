{{!
  @template mod_moodleoverflow/mail/digest_text

  The plain text daily digest of a user: the new posts grouped by course, moodleoverflow and discussion. Every value
  is printed unescaped with triple braces, as this is text, not HTML. Data from output\mail\digest.

  Context variables required for this template:
  * intro - The first line of the mail
  * complete - Whether the posts are shown (complete digest) or only one line per discussion (subjects)
  * courses - The courses, each with its heading and moodleoverflows
    * moodleoverflows - Each with its heading and discussions
      * discussions - Each with a summary line and its posts (empty unless the digest is complete), see
        mail/post_content_text
  * preferences - The line with the link to the forum preferences of the user

  Example context (json):
  {
    "intro": "You have new posts in the discussions you are subscribed to:",
    "complete": true,
    "courses": [{
      "name": "Course: Programming 1",
      "moodleoverflows": [{
        "name": "Forum: Lecture Q&A (https://example.com/mod/moodleoverflow/view.php?id=4)",
        "discussions": [{
          "summary": "There are 2 new posts in discussion 'Why does my recursive function never stop?': https://example.com/mod/moodleoverflow/discussion.php?d=2#p5",
          "posts": [{
            "url": "https://example.com/mod/moodleoverflow/discussion.php?d=2#p5",
            "by": "by Jacob Brown - Monday, 2 November 2026, 10:15 AM",
            "message": "Your function has no base case."
          }]
        }]
      }]
    }],
    "preferences": "Change your forum preferences: https://example.com/user/forum.php"
  }
}}
{{{intro}}}
{{#courses}}

{{{name}}}
=====================================================================
{{#moodleoverflows}}

{{{name}}}
{{#discussions}}
{{#complete}}

{{{summary}}}
{{/complete}}
{{^complete}}
    - {{{summary}}}
{{/complete}}
{{#posts}}

{{> mod_moodleoverflow/mail/post_content_text}}
{{/posts}}
{{/discussions}}
{{/moodleoverflows}}
{{/courses}}

{{{preferences}}}
