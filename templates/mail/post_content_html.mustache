{{!
  @template mod_moodleoverflow/mail/post_content_html

  One post in an HTML mail, included by the mails that show posts. Data from output\mail\post_content.

  Context variables required for this template:
  * headline - "<author> answered in "<discussion>"" (and the like), or null to show the author next to the date
  * author - The author as the recipient may see them, or null if the headline names them
  * date - The creation date in the recipient's timezone
  * messagehtml - The formatted post

  Example context (json):
  {
    "headline": null,
    "author": "Jacob Brown",
    "date": "Monday, 2 November 2026, 10:15 AM",
    "messagehtml": "<p>Your function has no base case.</p>"
  }
}}
{{#headline}}
<h2 style="margin:20px 0 4px;font-size:16px;line-height:1.4;font-weight:600;color:#1d2125;">{{headline}}</h2>
{{/headline}}
<div style="font-size:13px;line-height:1.5;color:#6a737b;">
    {{#author}}<span style="font-weight:600;color:#1d2125;">{{author}}</span> &middot; {{/author}}{{date}}
</div>
<div style="margin-top:12px;padding:2px 14px;background-color:#f6f8fb;border-radius:8px;">
    {{{messagehtml}}}
</div>
