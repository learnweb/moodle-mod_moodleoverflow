{{!
  @template mod_moodleoverflow/author_link

  The name of a post author, linked to the profile if the viewer may know who wrote the post.

  Example context (json):
  {
      "name": "Jane Doe",
      "profileurl": "https://example.com/user/view.php?id=2&course=3"
  }
}}
{{#profileurl}}<a href="{{profileurl}}">{{name}}</a>{{/profileurl}}{{^profileurl}}{{name}}{{/profileurl}}
