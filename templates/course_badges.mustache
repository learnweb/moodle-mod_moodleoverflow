{{!
  @template mod_moodleoverflow/course_badges

  The badges after the name of a moodleoverflow on the course page: the posts a reviewer has to review and the unread
  posts, both leading to the forum. The same badges as in the list of discussions.

  Example context (json):
  {
      "url": "https://example.com/mod/moodleoverflow/view.php?id=1",
      "reviewcount": 2,
      "unread": {
          "unreadlink": "https://example.com/mod/moodleoverflow/view.php?id=1",
          "unreadamount": 3,
          "domain": "moodleoverflow",
          "instanceid": 1
      }
  }
}}
{{#reviewcount}}
    <a href="{{{url}}}" class="badge rounded-pill bg-danger text-white text-decoration-none moodleoverflow-badge-link me-1"
       title="{{#str}}amount_waiting_for_review, mod_moodleoverflow, {{reviewcount}}{{/str}}">{{!
    }}{{#str}}reviewbadge, mod_moodleoverflow, {{reviewcount}}{{/str}}</a>
{{/reviewcount}}
{{#unread}}{{> mod_moodleoverflow/unread_badge}}{{/unread}}
