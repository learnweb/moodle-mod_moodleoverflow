{{!
  @template mod_moodleoverflow/pages/view/view_page

  Moodleoverflow discussion_list template.
  The purpose of this template is to render a list of discussions for the view.php.

  Example context (json):
  {
  }
}}

{{#header}}
    {{> mod_moodleoverflow/forum_header}}

    {{! Action bar in a light box: the calls to action stay visible (start a discussion, review), everything else of the
        user is in the menu "Forum actions" on the right: mark all as read, subscription and read tracking, statistics.
        Both toggle attributes: Bootstrap 4 (Moodle 4.5) reads data-toggle, Bootstrap 5 data-bs-toggle. }}
    <div class="bg-light border rounded p-2 mb-3" role="group" aria-label="{{#str}} forumactions, mod_moodleoverflow {{/str}}">
        <div class="d-flex align-items-center">
            <div class="d-flex flex-wrap align-items-center flex-grow-1">
                {{#startdiscussion}}
                    <a href="{{{link}}}" class="btn btn-primary m-1">{{#str}} addanewdiscussion, moodleoverflow {{/str}}</a>
                {{/startdiscussion}}
                {{#review_link}}
                    <a href="{{{review_link}}}" class="btn btn-danger m-1">{{#str}} review_needed, moodleoverflow {{/str}}</a>
                {{/review_link}}
            </div>
            {{#menu}}
                <div class="dropdown flex-shrink-0">
                    <button type="button" class="btn btn-outline-secondary m-1 moodleoverflow-icon-no-margin" data-toggle="dropdown"
                            data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                            title="{{#str}} forumactions, mod_moodleoverflow {{/str}}">
                        {{#pix}}i/moremenu, core{{/pix}}<span class="sr-only visually-hidden">{{#str}} forumactions, mod_moodleoverflow {{/str}}</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right dropdown-menu-end icon-size-3">
                        {{#markallread}}
                            <button type="button" id="{{itemid}}" class="dropdown-item"
                                    title="{{#str}} markallreaddesc, mod_moodleoverflow {{/str}}"
                                    data-domain="moodleoverflow" data-instanceid="{{instanceid}}" data-clearpage="1">{{!
                            }}{{#pix}}t/markasread, core{{/pix}}{{#str}} markallread_forum, moodleoverflow {{/str}}</button>
                            {{#js}}
                                require(['mod_moodleoverflow/readtracking'], function(readtracking) {
                                    readtracking.init({{#quote}}{{itemid}}{{/quote}});
                                });
                            {{/js}}
                            {{#dividernotifications}}<div class="dropdown-divider"></div>{{/dividernotifications}}
                        {{/markallread}}
                        {{#subscription}}{{> mod_moodleoverflow/subscription_toggle }}{{/subscription}}
                        {{#tracking}}{{> mod_moodleoverflow/tracking_toggle }}{{/tracking}}
                        {{#stats}}
                            {{#dividerstats}}<div class="dropdown-divider"></div>{{/dividerstats}}
                            <a href="{{{link}}}" class="dropdown-item" title="{{#str}} userstatsdesc, mod_moodleoverflow {{/str}}">{{!
                            }}{{#pix}}i/stats, core{{/pix}}{{#str}} seeuserstats, moodleoverflow {{/str}}</a>
                        {{/stats}}
                    </div>
                </div>
            {{/menu}}
        </div>
        {{! Search: the list shows only the discussions that contain the words. }}
        {{#search}}
            <div class="mt-2">
                {{> core/search_input }}
            </div>
        {{/search}}
    </div>
{{/header}}

<div id="moodleoverflow-root">
    {{! A search shows what it searched for; without results in the same calm box as an empty forum. }}
    {{#search}}
        {{#result}}
            {{#hasdiscussions}}
                <div class="d-flex flex-wrap justify-content-between align-items-center text-muted icon-size-3 mb-2">
                    <span>{{#pix}}a/search, core{{/pix}}{{result}}</span>
                    <a href="{{{clearurl}}}">{{#pix}}e/cancel, core{{/pix}}{{#str}} showalldiscussions, moodleoverflow {{/str}}</a>
                </div>
            {{/hasdiscussions}}
            {{^hasdiscussions}}
                <div class="text-center text-muted border rounded py-5 px-3">
                    <div class="icon-size-6 mb-2">{{#pix}}a/search, core{{/pix}}</div>
                    <p class="mb-1">{{result}}</p>
                    <p class="small mb-0"><a href="{{{clearurl}}}">{{#str}} showalldiscussions, moodleoverflow {{/str}}</a></p>
                </div>
            {{/hasdiscussions}}
        {{/result}}
    {{/search}}

    {{! An empty forum: a calm empty state with an icon; the button to ask is in the action bar above. }}
    {{^hasdiscussions}}{{^searching}}
        <div class="text-center text-muted border rounded py-5 px-3">
            <div class="icon-size-6 mb-2">{{#pix}}i/commenting, mod_moodleoverflow{{/pix}}</div>
            <p class="mb-1">{{#str}} nodiscussions, moodleoverflow {{/str}}</p>
            {{#header.startdiscussion}}<p class="small mb-0">{{#str}} nodiscussionsask, moodleoverflow {{/str}}</p>{{/header.startdiscussion}}
        </div>
    {{/searching}}{{/hasdiscussions}}

    {{#hasdiscussions}}
        {{! List of moodleoverflow where discussion can be moved to}}
        {{> mod_moodleoverflow/pages/view/topicmove_list}}

        {{! Paging bar if needed}}
        {{{paging_bar}}}

        {{! Print the table of discussions. }}
        {{#discussions}}
            {{{.}}}
        {{/discussions}}
        {{{paging_bar}}}
    {{/hasdiscussions}}
</div>
