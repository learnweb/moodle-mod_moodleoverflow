{{!
  @template mod_moodleoverflow/view_page

  Moodleoverflow discussion_list template.
  The purpose of this template is to render a list of discussions for the view.php.

  Example context (json):
  {
  }
}}

{{#anonymous_desc}}<p>{{anonymous_desc}}</p>{{/anonymous_desc}}
{{#review_desc}}<p>{{review_desc}}</p>{{/review_desc}}

<div id="moodleoverflow-root">
    {{! Action bar in a light box. Three groups: the main actions on the left, the user's own forum actions
        (subscribe, mark all read) and the statistics on the right. Without statistics the own actions are on the right,
        with them the own actions are in the middle. On a short line a group wraps as a whole; below the sm breakpoint
        all buttons stand below each other in the middle. Only classes that Bootstrap 4 and 5 both have. }}
    <div class="bg-light border rounded p-2 mb-3" role="group" aria-label="{{#str}} forumactions, mod_moodleoverflow {{/str}}">
        <div class="d-flex flex-column flex-sm-row flex-sm-wrap justify-content-between align-items-center">
            <div class="d-flex flex-column flex-sm-row align-items-center">
                {{#startdiscussion}}
                    <a href="{{{link}}}" class="btn btn-primary m-1">{{#str}} addanewdiscussion, moodleoverflow {{/str}}</a>
                {{/startdiscussion}}
                {{#review_link}}
                    <a href="{{{review_link}}}" class="btn btn-danger m-1">{{#str}} review_needed, moodleoverflow {{/str}}</a>
                {{/review_link}}
            </div>
            <div class="d-flex flex-column flex-sm-row align-items-center">
                {{#subscription}}
                    {{> mod_moodleoverflow/subscription_toggle }}
                {{/subscription}}
                {{#markallread}}
                    <button type="button" id="{{itemid}}" class="btn btn-outline-secondary m-1"
                            title="{{#str}} markallreaddesc, mod_moodleoverflow {{/str}}"
                            data-domain="moodleoverflow" data-instanceid="{{instanceid}}" data-clearpage="1">
                        {{#str}} markallread_forum, moodleoverflow {{/str}}
                    </button>
                    {{#js}}
                        require(['mod_moodleoverflow/readtracking'], function(readtracking) {
                        readtracking.init({{#quote}}{{itemid}}{{/quote}});
                        });
                    {{/js}}
                {{/markallread}}
            </div>
            {{#stats}}
                <div class="d-flex flex-column flex-sm-row align-items-center">
                    <a href="{{{link}}}" class="btn btn-outline-secondary m-1"
                       title="{{#str}} userstatsdesc, mod_moodleoverflow {{/str}}">
                        {{#str}} seeuserstats, moodleoverflow {{/str}}
                    </a>
                </div>
            {{/stats}}
        </div>
        {{! Search: the list shows only the discussions that contain the words. }}
        {{#search}}
            <div class="mt-2">
                {{> core/search_input }}
            </div>
        {{/search}}
    </div>

    {{#search}}
        {{#result}}
            <p>{{result}} <a href="{{{clearurl}}}">{{#str}} showalldiscussions, moodleoverflow {{/str}}</a></p>
        {{/result}}
    {{/search}}

    {{! There are no discussions. Print the string that specifies it. }}
    {{^hasdiscussions}}{{^searching}}
        <div class="moodleoverflowdiscussions" xmlns="http://www.w3.org/1999/xhtml">
            ( {{#str}} nodiscussions, moodleoverflow {{/str}} )
        </div>
    {{/searching}}{{/hasdiscussions}}

    {{#hasdiscussions}}
        {{! List of moodleoverflow where discussion can be moved to}}
        {{> mod_moodleoverflow/pages/view/topicmove_list}}

        {{! Paging bar if needed}}
        {{{paging_bar}}}

        {{! Print the table of discussions. }}
        {{#discussions}}
            {{{.}}}
        {{/discussions}}
        {{{paging_bar}}}
    {{/hasdiscussions}}
</div>
