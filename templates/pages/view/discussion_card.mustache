{{!
    @template mod_moodleoverflow/pages/view/discussion_card

    A discussion in the list of a moodleoverflow. First line: the title with the unread posts (a badge that leads to the
    first one) and a small bell when the user is subscribed, and a menu with "Mark as read", the subscription,
    "Move discussion" and "Delete discussion". Second line: the questioner, the numbers of the discussion (marks, votes,
    answers and comments, posts to review) and the last post.

    Example context (json):
    {
        "postid": 12,
        "subjecttext": "How do loops work?",
        "subjectlink": "https://example.com/mod/moodleoverflow/discussion.php?d=3",
        "question": {
            "author": {"name": "Jane Doe", "profileurl": "https://example.com/user/view.php?id=2&course=3", "picture": ""},
            "time": 1763400000
        },
        "votes": 3,
        "replyamount": 2,
        "lastpost": {"name": "John Doe", "time": 1763486400, "link": "https://example.com/mod/moodleoverflow/discussion.php?d=3#p14"}
    }
}}
<div class="moodleoverflowdiscussion discussioncard border px-3 py-2 mb-2" data-moodleoverflow-postid="{{postid}}">
    <div class="d-flex align-items-start">
        <div class="flex-grow-1 me-2 d-flex flex-wrap align-items-center">
            <a class="subject me-2" href="{{{subjectlink}}}">{{{subjecttext}}}</a>
            {{#unread}}{{> mod_moodleoverflow/unread_badge}}{{/unread}}
            {{#subscription}}
                {{! Only shows the state; subscription.js keeps it in line with the toggle in the menu. }}
                <span class="text-muted icon-size-3 ms-1" data-region="mod_moodleoverflow/subscription-state" data-type="{{type}}"
                      data-id="{{id}}"><span data-state="subscribed" class="{{^subscribed}}d-none{{/subscribed}}">{{!
                }}{{#pix}}i/subscribed, mod_moodleoverflow, {{#str}}subscribeddiscussion, mod_moodleoverflow{{/str}}{{/pix}}</span></span>
            {{/subscription}}
        </div>
        {{#hasmenu}}
            {{! Both toggle attributes: Bootstrap 4 (Moodle 4.5) reads data-toggle, Bootstrap 5 data-bs-toggle. }}
            <div class="dropdown flex-shrink-0">
                <button type="button" class="btn btn-link btn-sm moodleoverflow-icon-no-margin" data-toggle="dropdown"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="{{#str}}moremenu{{/str}}">
                    {{#pix}}i/moremenu, core{{/pix}}<span class="sr-only visually-hidden">{{#str}}moremenu{{/str}}</span>
                </button>
                <div class="dropdown-menu dropdown-menu-right dropdown-menu-end icon-size-3">
                    {{#unread}}
                        <button type="button" class="dropdown-item unread-part" id="{{itemid}}" data-domain="{{domain}}"
                                data-instanceid="{{instanceid}}" title="{{#str}}markallread, mod_moodleoverflow{{/str}}">{{!
                        }}{{#pix}}t/markasread, core{{/pix}}{{#str}}markread, mod_moodleoverflow{{/str}}</button>
                        {{#js}}
                            require(['mod_moodleoverflow/readtracking'], function(readtracking) {
                                readtracking.init({{#quote}}{{itemid}}{{/quote}});
                            });
                        {{/js}}
                    {{/unread}}
                    {{#subscription}}{{> mod_moodleoverflow/subscription_toggle }}{{/subscription}}
                    {{#canmovetopic}}
                        <button type="button" class="dropdown-item" data-action="moodleoverflow/movetopic-select"
                                data-discussionname="{{name}}" data-discussionid="{{id}}"
                                title="{{#str}}movetopicicon, mod_moodleoverflow{{/str}}">{{!
                        }}{{#pix}}i/move, mod_moodleoverflow{{/pix}}{{#str}}movediscussion, mod_moodleoverflow{{/str}}</button>
                    {{/canmovetopic}}
                    {{#delete}}
                        {{! Deleting the question deletes the discussion; deletepost.js asks first. }}
                        <button type="button" class="dropdown-item text-danger" data-action="mod_moodleoverflow/delete-post"
                                data-postid="{{postid}}" data-replies="{{replies}}" data-discussion="1">{{!
                        }}{{#pix}}t/delete, core{{/pix}}{{#str}}deletediscussion, mod_moodleoverflow{{/str}}</button>
                    {{/delete}}
                </div>
            </div>
        {{/hasmenu}}
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-1">
        {{#question}}{{> mod_moodleoverflow/author_line}}{{/question}}
        <div class="d-flex flex-wrap align-items-center text-muted">
            {{! The icons of the numbers are as small as the text (icon-size-3) and close to their number (no icon margin,
                one space); the groups keep a larger distance (me-3). }}
            <span class="icon-size-3 moodleoverflow-icon-no-margin text-nowrap">
                {{! Reviewers get the number of posts to review as a link (below); the others the number of their own posts
                    that wait for a review. }}
                {{^review}}{{#ownpending}}
                    <span class="me-3" title="{{#str}}ownpostspending, mod_moodleoverflow, {{ownpending}}{{/str}}">{{!
                    }}{{#pix}}i/pending-big, mod_moodleoverflow{{/pix}} {{ownpending}}</span>
                {{/ownpending}}{{/review}}
                {{^questionunderreview}}
                    {{#markedsolution}}<a href="{{link}}" class="me-2">{{#pix}}i/status-solved, mod_moodleoverflow, {{#str}}containsteacherrating, mod_moodleoverflow{{/str}}{{/pix}}</a>{{/markedsolution}}
                    {{#markedhelpful}}<a href="{{link}}" class="me-2">{{#pix}}i/status-helpful, mod_moodleoverflow, {{#str}}containsstarterrating, mod_moodleoverflow{{/str}}{{/pix}}</a>{{/markedhelpful}}
                {{/questionunderreview}}
                <span class="me-3" title="{{#str}}votes, mod_moodleoverflow, {{votes}}{{/str}}">{{#pix}}i/votes, mod_moodleoverflow{{/pix}} {{votes}}</span>
                <span class="me-3" title="{{replytitle}}">{{#pix}}i/commenting, mod_moodleoverflow{{/pix}} {{replyamount}}</span>
                {{#review}}
                    <a href="{{{link}}}" class="text-danger me-3" title="{{#str}}amount_waiting_for_review, mod_moodleoverflow, {{count}}{{/str}}">{{!
                    }}{{#pix}}i/pending-big, mod_moodleoverflow{{/pix}} {{count}}</a>
                {{/review}}
            </span>
            {{#lastpost}}
                <a href="{{{link}}}" class="text-reset">{{#str}}lastpostby, mod_moodleoverflow, {{name}}{{/str}} · {{!
                }}{{#userdate}}{{time}}, {{#str}}strftimedatemonthabbr, core_langconfig{{/str}}{{/userdate}}</a>
            {{/lastpost}}
        </div>
    </div>
</div>
