{{!
  @template mod_moodleoverflow/post

  Moodleoverflow post template.
  The purpose of this template is to render a post in the discussion.

   Example context (json):
   {
   }
}}

{{! Print an anchor if the post is the first unread post of the discussion. }}
{{#isfirstunread}}
    <a id="unread"></a>
{{/isfirstunread}}

{{! Start the post. }}
<div class="{{#iscomment}}indent{{/iscomment}}{{^iscomment}}tmargin{{/iscomment}}">
<div id="p{{postid}}" class="moodleoverflowpost border {{#iscomment}}bg-light moodleoverflowcomment{{/iscomment}}
 {{postclass}} {{#needsreview}}pendingreview{{/needsreview}}
    {{#isfirstpost}}firstpost starter{{/isfirstpost}}" role="region" aria-label="{{ author.name }}"
     data-moodleoverflow-postid="{{postid}}">
    <div class="d-flex p-2 w-100">
        <div class="left-info text-center">
            {{#showvotes}}
                <div class="votecell onlyifreviewed">
                    <div class="votes">
                        {{> mod_moodleoverflow/postvoting }}
                    </div>
                </div>
            {{/showvotes}}
            {{^showvotes}}
                <div class="novotecell onlyifreviewed"></div>
            {{/showvotes}}
            {{#needsreview}}
                <div class="onlyifnotreviewed pr-2 moodleoverflow-icon-no-margin">
                    {{#pix}}i/pending-big, mod_moodleoverflow,
                        {{#withinreviewperiod}}
                            {{#str}}pending_review, mod_moodleoverflow{{/str}}
                        {{/withinreviewperiod}}
                        {{^withinreviewperiod}}
                            {{#str}}pending_review_but_cannot_now, mod_moodleoverflow, {{reviewdelay}} {{/str}}
                        {{/withinreviewperiod}}
                    {{/pix}}
                </div>
            {{/needsreview}}
            {{! Who may set a mark gets a switch with the action as tooltip, the others see the mark only when it is set. }}
            <div class="status moodleoverflow-icon-no-margin">
                {{#commands.marksolved}}
                    <button type="button" class="btn btn-link p-0 marksolved" data-moodleoverflow-action="solved" title="{{label}}">{{!
                    }}{{#pix}}i/status-solved, moodleoverflow{{/pix}}</button>
                {{/commands.marksolved}}
                {{^commands.marksolved}}
                    <span class="onlyifsolved">{{#pix}} i/status-solved, moodleoverflow, {{#str}}ratedbyteacher, moodleoverflow{{/str}} {{/pix}}</span>
                {{/commands.marksolved}}
                {{#commands.markhelpful}}
                    <button type="button" class="btn btn-link p-0 markhelpful" data-moodleoverflow-action="helpful" title="{{label}}">{{!
                    }}{{#pix}}i/status-helpful, moodleoverflow{{/pix}}</button>
                {{/commands.markhelpful}}
                {{^commands.markhelpful}}
                    <span class="onlyifhelpful">{{#pix}} i/status-helpful, moodleoverflow, {{#str}}ratedbystarter, moodleoverflow{{/str}} {{/pix}}</span>
                {{/commands.markhelpful}}
            </div>
        </div>
        <div class="answercell d-flex flex-column">
            <div class="post-text">
                {{{ postcontent }}}
            </div>
            {{! Attached images are thumbnails that open the full image, files are links with their icon. mb-n1 takes back
                the space below the last item, so the line below keeps its distance. }}
            <div class="attachments flex-grow-1">
                {{#attachments.0}}
                    <div class="mt-2 mb-n1">
                        <ul class="list-inline mb-0">
                            {{#attachments}}{{#isimage}}
                                <li class="list-inline-item mb-1">
                                    <a href="{{{url}}}" target="_blank" title="{{filename}}"><img src="{{{url}}}" alt="{{filename}}" class="img-thumbnail"></a>
                                </li>
                            {{/isimage}}{{/attachments}}
                        </ul>
                        <ul class="list-unstyled mb-0">
                            {{#attachments}}{{^isimage}}
                                <li class="mb-1"><a href="{{{url}}}" class="icon-size-5">{{#pix}}{{icon}}, core{{/pix}}{{filename}}</a></li>
                            {{/isimage}}{{/attachments}}
                        </ul>
                    </div>
                {{/attachments.0}}
            </div>
            <div class="post-info border-top pt-2 mt-2">
                {{! One line for every post: picture (a placeholder for hidden authors), name, reputation, role, date. }}
                <div class="leftbox">
                    <div class="user-info text-muted">
                        {{#author.picture}}{{{author.picture}}}{{/author.picture}}{{!
                        }}{{^author.picture}}<span class="userinitials size-35 moodleoverflow-icon-no-margin">{{#pix}}i/user, core{{/pix}}</span>{{/author.picture}}
                        {{#author}}{{> mod_moodleoverflow/author}}{{/author}}
                        {{#isquestioner}}<span class="badge bg-light text-dark border">{{#str}}questioner, mod_moodleoverflow{{/str}}</span>{{/isquestioner}}
                        · <span title="{{date}}">{{shortdate}}</span>
                    </div>
                </div>
                <div class="rightbox">
                    <div class="post-menu">
                        {{#commands}}{{> mod_moodleoverflow/post_commands}}{{/commands}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{#canreview}}
        <div class="reviewrow p-2 text-center bg-gray">
            {{#canreviewnow}}
                {{> mod_moodleoverflow/review_buttons }}
            {{/canreviewnow}}
            {{^canreviewnow}}
                {{#str}}pending_review_but_cannot_now, mod_moodleoverflow, {{needsreview.reviewdelay}} {{/str}}
            {{/canreviewnow}}
        </div>
    {{/canreview}}
</div>
</div>
