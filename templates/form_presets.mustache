{{!
    @template mod_moodleoverflow/form_presets

    The descriptions of the presets below the preset choice in the settings form. They sit in the field column of the
    form; mod_moodleoverflow/presets shows the one of the chosen preset.

    Example context (json):
    {
        "presets": [
            {"key": "lecture", "name": "Questions about a lecture", "description": "Students ask with their name."}
        ]
    }
}}
<div class="mb-3 row fitem" data-region="mod_moodleoverflow-presets">
    <div class="col-md-3"></div>
    <div class="col-md-9">
        {{#presets}}
            <div class="d-none border rounded bg-light p-3" data-preset="{{key}}">
                <strong>{{name}}</strong>
                <p class="mb-0">{{description}}</p>
            </div>
        {{/presets}}
    </div>
</div>
