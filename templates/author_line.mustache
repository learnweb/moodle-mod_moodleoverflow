{{!
  @template mod_moodleoverflow/author_line

  The author of a post in one line, on the discussion page and in the list of discussions: the picture (a placeholder
  for hidden authors), the name and reputation (template author), the label "Questioner" and the date with the exact
  time as tooltip.

  Example context (json):
  {
      "author": {"name": "Jane Doe", "profileurl": "https://example.com/user/view.php?id=2&course=3", "picture": ""},
      "isquestioner": true,
      "time": 1763400000
  }
}}
<div class="moodleoverflow-author text-muted">
    {{#author.picture}}{{{author.picture}}}{{/author.picture}}{{!
    }}{{^author.picture}}<span class="userinitials size-35 moodleoverflow-icon-no-margin">{{#pix}}i/user, core{{/pix}}</span>{{/author.picture}}
    {{#author}}{{> mod_moodleoverflow/author}}{{/author}}
    {{#isquestioner}}<span class="badge bg-light text-dark border">{{#str}}questioner, mod_moodleoverflow{{/str}}</span>{{/isquestioner}}
    · <span title="{{#userdate}}{{time}}, {{#str}}strftimedaydatetime, core_langconfig{{/str}}{{/userdate}}">{{!
    }}{{#userdate}}{{time}}, {{#str}}strftimedatemonthabbr, core_langconfig{{/str}}{{/userdate}}</span>
</div>
